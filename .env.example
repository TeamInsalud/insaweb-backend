# En desarrollo: copie este archivo como .env. En Coolify: cargue estas variables en la configuración del servicio.

# Zona horaria local (Venezuela)
TZ=America/Caracas

# Puerto y dirección donde escucha la API (0.0.0.0 = todas las interfaces de red)
PORT=3001
HOST=0.0.0.0

# Base de datos MySQL en servidor 10.10.0.4
DB_HOST=10.10.0.4
DB_PORT=3306
DB_USER=insaweb
DB_PASSWORD=TuClaveSeguraAqui
DB_NAME=o0002a2026

# Secreto para firmar las sesiones: obligatorio y distinto en cada instalación. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=insaweb-insalud-local-jwt-secret-2026-coolify-10-10-0-7
JWT_EXPIRES=8h

# Historial de pagos por año: bases <DB_PREFIX><año> desde el año actual hasta HIST_DESDE
DB_PREFIX=o0002a
HIST_DESDE=2003

# Con un proxy delante (Coolify/Traefik, nginx), para registrar en la auditoría la IP real del usuario.
# En Coolify use TRUST_PROXY=true. En desarrollo déjelo vacío.
TRUST_PROXY=true

# Solo si el frontend se publica en otro nombre o puerto que la API (separe varios con comas), p. ej.
#   CORS_ORIGIN=http://10.10.0.7:8080,http://consulta.insalud.local
# Si el frontend envía /api a este servicio por su propio proxy (mismo origen), déjelo vacío.
CORS_ORIGIN=
